APP_ENV=local

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=apps/api/storage
PROCESSING_TMP_DIR=
MAX_UPLOAD_BYTES=52428800
POPPLER_PDFTOPPM=pdftoppm
LOCAL_TRANSLATION_PROFILE=hplt-en-sl-v2
LOCAL_TRANSLATION_MODEL_PATH=local-models/hplt-en-sl-v2-ct2-int8
LOCAL_TRANSLATION_DEVICE=cpu
LOCAL_TRANSLATION_COMPUTE_TYPE=int8
GLOSSARY_DATABASE_PATH=local-data/glossary.sqlite3

# Database
POSTGRES_DB=pdf_translator
POSTGRES_USER=pdf_translator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://pdf_translator:change-me@postgres:5432/pdf_translator

# Queue
REDIS_URL=redis://redis:6379/0
